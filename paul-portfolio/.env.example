# Copy this file to ".env" for local work. Never commit ".env".
# In production, set these in Netlify (Site settings > Environment variables)
# or Vercel (Project settings > Environment Variables), then redeploy.

# Your live domain, no trailing slash. Used for canonical URLs, Open Graph
# links and the generated sitemap. Leave empty until you have a domain.
VITE_SITE_URL=

# Form endpoint that receives contact messages. Formspree example:
#   https://formspree.io/f/xxxxxxxx
# Leave empty and the contact form shows an honest "not connected" state
# instead of pretending to send.
VITE_CONTACT_FORM_ENDPOINT=
